// Iron of the skeleton soldiers' heater shields: IronShader (the sword fittings) under its OWN identity, because a
// blocked hit flashes exactly the shield's material slots blue (SkeletonBody.FlashMaterials matches by material)
// and must not light the sword's crossguard with it. Keep the numbers in step with ironshader.vmat.

Layer0
{
	shader "shaders/heden_metal.shader"

	//---- Albedo ----
	F_USE_TEXTURE 1

	//---- Toon Lighting ----
	F_USE_RAMP 1

	//---- Albedo ----
	AlbedoTexture "textures/dungeontextures/dungeons_texture_01.png"
	g_flObjectTintMode "0.000"
	g_vTextureTint "[0.640000 0.640000 0.680000 0.000000]"

	//---- Brush ----
	g_flBrushAngle "90.000"
	g_flBrushScale "0.500"
	g_flBrushStrength "0.180"
	g_flBrushStretch "6.000"

	//---- Debug ----
	g_flDebugMode "0.000"

	//---- Dynamic Lights ----
	g_flDynamicLightBands "4.000"
	g_flDynamicLightBandSoftness "0.080"
	g_flDynamicLightOuterBandScale "1.000"
	g_flDynamicLightOuterSoftness "0.400"
	g_flDynamicLightStrength "1.000"
	g_flDynamicLightWrap "1.000"

	//---- Edge Light ----
	g_flEdgeSoftness "0.050"
	g_flEdgeStrength "0.300"
	g_flEdgeThreshold "0.700"
	g_vEdgeColor "[0.750000 0.800000 0.880000 0.000000]"

	//---- Glint ----
	g_flGlintIntensity "0.700"
	g_flGlintPower "32.000"
	g_flGlintSoftness "0.090"
	g_flGlintThreshold "0.480"
	g_vGlintTint "[0.900000 0.920000 0.960000 0.000000]"

	//---- Metal ----
	MetalNoise "materials/water_noise_01.png"

	//---- Reflection ----
	g_flReflectHorizon "0.000"
	g_flReflectNoise "0.400"
	g_flReflectNoiseScale "0.500"
	g_flReflectSoftness "0.060"
	g_flReflectStrength "0.380"
	g_flReflectWidth "0.240"
	g_vReflectGroundTint "[0.560000 0.560000 0.600000 0.000000]"
	g_vReflectHorizonTint "[0.280000 0.290000 0.340000 0.000000]"
	g_vReflectSkyTint "[0.850000 0.860000 0.900000 0.000000]"

	//---- Rim Light ----
	g_flRimSoftness "0.050"
	g_flRimStrength "0.000"
	g_flRimSunWeight "1.000"
	g_flRimThreshold "0.600"
	g_vRimColor "[1.000000 0.968628 0.901961 0.000000]"

	//---- Style Test ----
	DetailTexture "materials/style_detail/detail_grain.png"
	g_flCrushHuePreserve "0.500"
	g_flCrushLevels "64.000"
	g_flDetailObjectSpace "1.000"
	g_flDetailScale "16.000"
	g_flDetailStrength "0.100"
	g_flDetailWobble "0.000"
	g_flDetailWobbleScale "16.000"

	//---- Toon Lighting ----
	g_flAmbientFloor "0.050"
	g_flAmbientLift "0.150"
	g_flBandSoftness "0.005"
	g_flBandThreshold "0.500"
	g_flCrispSunShadows "1.000"
	g_flShadowBandSoftness "0.030"
	g_flShadowNormalOffset "2.000"
	g_flShadowSmoothing "1.500"
	g_flSunColorInfluence "0.400"

	//---- Toon Ramp ----
	g_flRampBrightness "1.000"
	g_flRampShadowPoint "0.250"
	ToonRamp "materials/heden_ramp_day.png"
	ToonRampNight "materials/heden_ramp_night.png"
}
