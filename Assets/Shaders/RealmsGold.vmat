// Hand-maintained. Cloned from IronShader.vmat and retargeted at the Dungeon Realms atlas; the tuning
// below came with it. gen_pack_assets.py writes the remap that points at this file but never
// writes the file itself -- see PACKS['realms']['specials'].
// The 24 gold and coin meshes. Synty gives these their own 1024 diffuse rather than the
// atlas, and a warm tint over the iron shader's brushed-metal response reads as gold.

Layer0
{
	shader "shaders/heden_metal.shader"

	//---- Albedo ----
	F_USE_TEXTURE 1

	//---- Toon Lighting ----
	F_USE_RAMP 1

	//---- Albedo ----
	AlbedoTexture "textures/dungeonrealmstextures/gold_diffuse.png"
	g_flObjectTintMode "0.000"
	g_vTextureTint "1.000000 0.843137 0.376471 0.000000"

	//---- Brush ----
	g_flBrushAngle "90.000"
	g_flBrushScale "0.500"
	g_flBrushStrength "0.180"
	g_flBrushStretch "6.000"

	//---- Debug ----
	g_flDebugMode "0.000"

	//---- Dynamic Lights ----
	g_flDynamicLightBands "4.000"
	g_flDynamicLightBandSoftness "0.080"
	g_flDynamicLightOuterBandScale "1.000"
	g_flDynamicLightOuterSoftness "0.400"
	g_flDynamicLightStrength "1.000"
	g_flDynamicLightWrap "1.000"

	//---- Edge Light ----
	g_flEdgeSoftness "0.050"
	g_flEdgeStrength "0.200"
	g_flEdgeThreshold "0.800"
	g_vEdgeColor "[0.749020 0.800000 0.878431 0.000000]"

	//---- Glint ----
	g_flGlintIntensity "0.700"
	g_flGlintPower "32.000"
	g_flGlintSoftness "0.090"
	g_flGlintThreshold "0.480"
	g_vGlintTint "[0.901961 0.921569 0.960784 0.000000]"

	//---- Metal ----
	MetalNoise "materials/water_noise_01.png"

	//---- Reflection ----
	g_flReflectHorizon "0.034"
	g_flReflectNoise "0.300"
	g_flReflectNoiseScale "0.500"
	g_flReflectSoftness "0.050"
	g_flReflectStrength "0.350"
	g_flReflectWidth "0.220"
	g_vReflectGroundTint "[0.400000 0.419608 0.478431 0.000000]"
	g_vReflectHorizonTint "[0.780392 0.780392 0.800000 0.000000]"
	g_vReflectSkyTint "[1.000000 1.000000 1.000000 0.000000]"

	//---- Rim Light ----
	g_flRimSoftness "0.097"
	g_flRimStrength "0.000"
	g_flRimSunWeight "0.398"
	g_flRimThreshold "0.627"
	g_vRimColor "[1.000000 0.968628 0.901961 0.000000]"

	//---- Style Test ----
	DetailTexture "materials/style_detail/detail_grain.png"
	g_flCrushHuePreserve "0.500"
	g_flCrushLevels "64.000"
	g_flDetailObjectSpace "1.000"
	g_flDetailScale "16.000"
	g_flDetailStrength "0.100"
	g_flDetailWobble "0.000"
	g_flDetailWobbleScale "16.000"

	//---- Toon Lighting ----
	g_flAmbientFloor "0.050"
	g_flAmbientLift "0.150"
	g_flBandSoftness "0.005"
	g_flBandThreshold "0.500"
	g_flCrispSunShadows "1.000"
	g_flShadowBandSoftness "0.030"
	g_flShadowNormalOffset "2.000"
	g_flShadowSmoothing "1.500"
	g_flSunColorInfluence "0.400"

	//---- Toon Ramp ----
	g_flRampBrightness "1.000"
	g_flRampShadowPoint "0.250"
	ToonRamp "materials/heden_ramp_day.png"
	ToonRampNight "materials/heden_ramp_night.png"
}