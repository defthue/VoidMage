// Wheat patches (SM_Prop_Plant_Wheat_01..03, Polygon Farm exports). Their FBX material
// is a raw farm-atlas lambert whose UVs mean nothing against our atlases — a flat gold
// albedo texture makes the UV layout irrelevant. Toon params mirror treeshader.vmat.
// No wind: the shared fantasykingdomoutline.vmat has no wind either, and a swaying mesh
// under a static outline shell tears the ink apart.

Layer0
{
	shader "shaders/heden_toon.shader"

	//---- Albedo ----
	F_USE_TEXTURE 1

	//---- Rim Light ----

	//---- Toon Lighting ----
	F_USE_RAMP 1

	//---- Albedo ----
	AlbedoTexture "materials/heden_flat_wheat.png"
	g_vTextureTint "[1.000000 1.000000 1.000000 0.000000]"

	//---- Debug ----
	g_flDebugMode "0.000"

	//---- Rim Light ----
	g_flRimSoftness "0.050"
	g_flRimStrength "0.200"
	g_flRimSunWeight "1.000"
	g_flRimThreshold "0.900"
	g_vRimColor "[1.000000 0.968628 0.901961 0.000000]"

	//---- Toon Lighting ----
	g_flAmbientLift "0.500"
	g_flAmbientFloor "0.500"
	g_flBandSoftness "0.005"
	g_flBandThreshold "0.500"
	g_flCrispSunShadows "1.000"
	g_flShadowBandSoftness "0.030"
	g_flShadowNormalOffset "2.000"
	g_flShadowSmoothing "1.500"
	g_flSunColorInfluence "0.400"
	g_flNightResponse "1.000"
	g_flNightAmbientFloor "0.120"
	g_flNightSunColorInfluence "1.000"

	//---- Toon Ramp ----
	g_flRampBrightness "1.000"
	g_flRampShadowPoint "0.250"
	ToonRamp "materials/heden_ramp_day.png"
	ToonRampNight "materials/heden_ramp_night.png"

	//---- Style Test ----
	DetailTexture "materials/style_detail/detail_grain.png"
	g_flCrushHuePreserve "0.500"
	g_flCrushLevels "64.000"
	g_flDetailScale "32.000"
	g_flDetailStrength "0.050"
	g_flDetailWobble "0.010"
	g_flDetailWobbleScale "16.000"
}
